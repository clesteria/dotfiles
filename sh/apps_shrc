# ----------------------------------------
# Editor
# ----------------------------------------

## vim
export EDITOR="vim"

## neovim
if command -v nvim >/dev/null 2>&1; then
  alias vi="nvim"
  alias vim="nvim"
fi

# ----------------------------------------
# Alternative default command
# ----------------------------------------

## eza
if command -v eza >/dev/null 2>&1; then
  alias ls='eza -g --group-directories-first'
  alias ll='eza -lagh --group-directories-first --git --time-style full-iso'
fi

## bat
if command -v bat >/dev/null 2>&1; then
  export BAT_PAGER="cat"
fi

# ----------------------------------------
# Programming language
# ----------------------------------------

## nim
if test -d "${HOME}/.nimble/bin"; then
  export PATH="${HOME}/.nimble/bin:${PATH}"
fi

## rust
if command -v cargo >/dev/null 2>&1; then
  export CARGO_HOME="${HOME}/.cargo"
  export PATH="${CARGO_HOME}/bin:${PATH}"
fi

## .NET Core SDK
if command -v dotnet >/dev/null 2>&1; then
  export PATH="${HOME}/.dotnet/tools:${PATH}"
fi

## node.js(nvm)
if test -s "${HOME}/.nvm/nvm.sh"; then
  export NVM_DIR="${HOME}/.nvm"
  . ${NVM_DIR}/nvm.sh 2>/dev/null
fi

# ----------------------------------------
# Git
# ----------------------------------------

## Radicle
if test -d "${HOME}/.radicle/bin"; then
  export PATH="${HOME}/.radicle/bin:${PATH}"
fi

## ghq
if command -v ghq sk > /dev/null 2>&1; then
  function Set-GitLocation () {
    GHQROOT="$(ghq root)"
    GHQDIR="$(ghq list | sk)"
    test -z "${GHQDIR}" && return
    test -d "${GHQROOT}/${GHQDIR}" || return
    cd ${GHQROOT}/${GHQDIR}
  }
  alias g='Set-GitLocation'
fi
