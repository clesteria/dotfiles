# ----------------------------------------
# Editor
# ----------------------------------------

## vim
export EDITOR="vim"

## neovim
if command -v nvim >/dev/null 2>&1; then
  alias vi="nvim"
  alias vim="nvim"
fi

# ----------------------------------------
# Alternative default command
# ----------------------------------------

## eza
if command -v eza >/dev/null 2>&1; then
  alias ls='eza -g'
  alias ll='eza -lagh --git --time-style full-iso'
fi

## bat
if command -v bat >/dev/null 2>&1; then
  export BAT_PAGER="cat"
fi

# ----------------------------------------
# env
# ----------------------------------------

## enyenv
if command -v anyenv >/dev/null 2>&1; then
  eval "$(anyenv init -)"
fi

# ----------------------------------------
# Programming language
# ----------------------------------------

## nim
if command -v choosenim >/dev/null 2>&1; then
  export PATH="$(choosenim show path)/bin:${PATH}"
fi

if command -v nimble >/dev/null 2>&1; then
  export PATH="${HOME}/.nimble/bin:${PATH}"
fi

## rust
if command -v cargo >/dev/null 2>&1; then
  export CARGO_HOME="${HOME}/.cargo"
  export PATH="${CARGO_HOME}/bin:${PATH}"
fi

## .NET Core SDK
if command -v dotnet >/dev/null 2>&1; then
  export PATH="${HOME}/.dotnet/tools:${PATH}"
fi

## nodebrew
if command -v nodebrew >/dev/null 2>&1; then
  export PATH="${HOME}/.nodebrew/current/bin:${PATH}"
fi

# ----------------------------------------
# homebrew
# ----------------------------------------

## ghq
if command -v ghq peco > /dev/null 2>&1; then
  function Set-GitLocation () {
    GHQROOT="$(ghq root)"
    GHQDIR="$(ghq list | peco)"
    test -z "${GHQDIR}" && return
    test -d "${GHQROOT}/${GHQDIR}" || return
    cd ${GHQROOT}/${GHQDIR}
  }
  alias g='Set-GitLocation'
fi
